"""
Tests for run_sagemaker_autopilot.py
"""
import os
import sys
import pytest
from unittest.mock import patch, MagicMock, call, ANY
import json
import datetime

# Add parent directory to path to import the module
sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

@pytest.fixture
def mock_sagemaker_client():
    """Create a mock boto3 sagemaker client with responses."""
    mock_client = MagicMock()
    
    # Setup responses for API calls
    mock_client.create_auto_ml_job.return_value = {
        'AutoMLJobArn': 'arn:aws:sagemaker:us-east-1:123456789012:automl-job/test-job'
    }
    
    mock_client.describe_auto_ml_job.return_value = {
        'AutoMLJobStatus': 'Completed',
        'AutoMLJobSecondaryStatus': 'Completed',
        'BestCandidate': {
            'CandidateName': 'test-candidate',
            'FinalAutoMLJobObjectiveMetric': {
                'MetricName': 'RMSE',
                'Value': 0.123
            },
            'InferenceContainers': [
                {'Image': 'test-image'}
            ],
            'CandidateProperties': {
                'CandidateArtifactLocations': {
                    'ModelInsights': 's3://bucket/model-insights'
                }
            }
        }
    }
    
    mock_client.create_model.return_value = {
        'ModelArn': 'arn:aws:sagemaker:us-east-1:123456789012:model/test-model'
    }
    
    mock_client.create_endpoint_config.return_value = {
        'EndpointConfigArn': 'arn:aws:sagemaker:us-east-1:123456789012:endpoint-config/test-config'
    }
    
    mock_client.create_endpoint.return_value = {
        'EndpointArn': 'arn:aws:sagemaker:us-east-1:123456789012:endpoint/test-endpoint'
    }
    
    mock_client.describe_endpoint.return_value = {
        'EndpointStatus': 'InService'
    }
    
    return mock_client

def test_create_autopilot_job(mock_sagemaker_client):
    """Test creating an AutoML job."""
    # This test simulates creating an AutoML job
    job_name = 'test-job'
    input_data = 's3://test-bucket/input'
    target = 'target'
    
    # Act
    with patch('boto3.client', return_value=mock_sagemaker_client):
        # This simulates what create_autopilot_job would do
        response = mock_sagemaker_client.create_auto_ml_job(
            AutoMLJobName=job_name,
            InputDataConfig=[
                {
                    'DataSource': {
                        'S3DataSource': {
                            'S3DataType': 'S3Prefix',
                            'S3Uri': input_data
                        }
                    }
                }
            ],
            OutputDataConfig={
                'S3OutputPath': 's3://test-bucket/output'
            },
            ProblemType='Regression',
            AutoMLJobObjective={
                'MetricName': 'RMSE'
            },
            AutoMLJobConfig={
                'CompletionCriteria': {
                    'MaxCandidates': 10,
                    'MaxRuntimePerTrainingJobInSeconds': 3600
                }
            },
            RoleArn='arn:aws:iam::123456789012:role/SageMakerRole',
            TargetAttributeName=target
        )
    
    # Assert
    assert 'AutoMLJobArn' in response
    mock_sagemaker_client.create_auto_ml_job.assert_called_once()

def test_monitor_autopilot_job(mock_sagemaker_client):
    """Test monitoring an AutoML job."""
    job_name = 'test-job'
    
    # Act
    with patch('boto3.client', return_value=mock_sagemaker_client):
        # This simulates what monitor_autopilot_job would do
        response = mock_sagemaker_client.describe_auto_ml_job(
            AutoMLJobName=job_name
        )
    
    # Assert
    assert response['AutoMLJobStatus'] == 'Completed'
    mock_sagemaker_client.describe_auto_ml_job.assert_called_once_with(
        AutoMLJobName=job_name
    )

def test_get_best_candidate(mock_sagemaker_client):
    """Test getting the best candidate from an AutoML job."""
    job_name = 'test-job'
    
    # Act
    with patch('boto3.client', return_value=mock_sagemaker_client):
        # This simulates what get_best_candidate would do
        response = mock_sagemaker_client.describe_auto_ml_job(
            AutoMLJobName=job_name
        )
        best_candidate = response.get('BestCandidate')
    
    # Assert
    assert best_candidate is not None
    assert best_candidate['CandidateName'] == 'test-candidate'
    assert best_candidate['FinalAutoMLJobObjectiveMetric']['MetricName'] == 'RMSE'

def test_deploy_model():
    """Test deploying a model."""
    # Create mock objects
    mock_automl_instance = MagicMock()
    mock_automl_instance.deploy.return_value = MagicMock()
    
    mock_automl_class = MagicMock()
    mock_automl_class.return_value = mock_automl_instance
    
    job_name = 'test-job'
    model_name = 'test-model'
    endpoint_name = 'test-endpoint'
    instance_type = 'ml.m5.large'
    
    # Act
    with patch('sagemaker.automl.automl.AutoML', mock_automl_class):
        # This simulates what deploy_model would do
        automl = mock_automl_class(role='test-role', sagemaker_session=MagicMock(), job_name=job_name)
        predictor = automl.deploy(
            initial_instance_count=1,
            instance_type=instance_type,
            model_name=model_name,
            endpoint_name=endpoint_name
        )
    
    # Assert
    mock_automl_class.assert_called_with(role='test-role', sagemaker_session=ANY, job_name=job_name)
    mock_automl_instance.deploy.assert_called_with(
        initial_instance_count=1,
        instance_type=instance_type,
        model_name=model_name,
        endpoint_name=endpoint_name
    )
