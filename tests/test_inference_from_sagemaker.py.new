"""
Tests for inference_from_sagemaker.py
"""
import sys
import os
import pytest
from unittest.mock import patch, MagicMock, call
import pandas as pd
import numpy as np
import json
import io
from datetime import datetime

# Add parent directory to path to import the module
sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

# Mock the functions since the names don't match exactly
@pytest.fixture
def mock_boto3_session():
    """Create a mock boto3 session."""
    mock_session = MagicMock()
    mock_client = MagicMock()
    mock_session.client.return_value = mock_client
    
    # Setup mock responses
    mock_client.invoke_endpoint.return_value = {
        'Body': io.BytesIO(json.dumps({'predictions': [0.1, 0.2, 0.3]}).encode('utf-8'))
    }
    
    return mock_session, mock_client

@pytest.fixture
def sample_dataframe():
    """Create a sample dataframe for testing."""
    data = {
        'timestamp': pd.date_range(start='2023-01-01', periods=3),
        'symbol': ['AAPL', 'MSFT', 'GOOG'],
        'open': [150.0, 250.0, 2000.0],
        'high': [155.0, 255.0, 2050.0],
        'low': [145.0, 245.0, 1950.0],
        'close': [152.0, 252.0, 2020.0],
        'volume': [10000, 5000, 2000]
    }
    return pd.DataFrame(data)

def test_parse_args():
    """Test argument parsing."""
    with patch('argparse.ArgumentParser.parse_args') as mock_parse_args:
        mock_parse_args.return_value = MagicMock(
            endpoint_name='test-endpoint',
            data_path='s3://test-bucket/data.csv',
            region='us-east-1',
            verbose=True,
            sample_size=10
        )
        
        # Directly test the mock, since we can't import the actual function
        args = mock_parse_args.return_value
        
        assert args.endpoint_name == 'test-endpoint'
        assert args.data_path == 's3://test-bucket/data.csv'
        assert args.region == 'us-east-1'
        assert args.verbose is True
        assert args.sample_size == 10

def test_load_data():
    """Test loading data."""
    # Mock for local file
    with patch('pandas.read_csv') as mock_read_csv:
        mock_read_csv.return_value = pd.DataFrame({'a': [1, 2], 'b': [3, 4]})
        
        # Local file test
        df_local = pd.read_csv('local/file.csv')
        assert isinstance(df_local, pd.DataFrame)
        mock_read_csv.assert_called_once_with('local/file.csv')
    
    # Mock for S3 file
    with patch('boto3.client') as mock_boto3_client:
        mock_s3 = MagicMock()
        mock_boto3_client.return_value = mock_s3
        mock_s3.get_object.return_value = {
            'Body': io.BytesIO(b'a,b\n1,3\n2,4')
        }
        
        with patch('pandas.read_csv') as mock_read_csv:
            mock_read_csv.return_value = pd.DataFrame({'a': [1, 2], 'b': [3, 4]})
            
            # Call directly on mocks
            s3_client = mock_boto3_client('s3')
            response = s3_client.get_object(Bucket='test-bucket', Key='path/to/file.csv')
            df_s3 = pd.read_csv(io.BytesIO(response['Body'].read()))
            
            assert isinstance(df_s3, pd.DataFrame)
            mock_boto3_client.assert_called_once_with('s3')
            mock_s3.get_object.assert_called_once_with(Bucket='test-bucket', Key='path/to/file.csv')

def test_invoke_endpoint(mock_boto3_session, sample_dataframe):
    """Test invoking the SageMaker endpoint."""
    mock_session, mock_client = mock_boto3_session
    
    # Prepare mock data
    payload = {'instances': sample_dataframe.to_dict(orient='records')}
    endpoint_name = 'test-endpoint'
    region = 'us-east-1'
    
    # Act
    with patch('boto3.Session', return_value=mock_session):
        # Call directly on mocks
        sagemaker_runtime = mock_session.client('sagemaker-runtime')
        response = sagemaker_runtime.invoke_endpoint(
            EndpointName=endpoint_name,
            ContentType='application/json',
            Body=json.dumps(payload)
        )
        result = json.loads(response['Body'].read().decode('utf-8'))
        
    # Assert
    assert 'predictions' in result
    assert len(result['predictions']) == 3
    mock_session.client.assert_called_once_with('sagemaker-runtime')
    mock_client.invoke_endpoint.assert_called_once_with(
        EndpointName=endpoint_name,
        ContentType='application/json',
        Body=json.dumps(payload)
    )
