"""
Tests for inspect_parquet_data.py
"""
import sys
import os
import pytest
from unittest.mock import patch, MagicMock, call
import pandas as pd
import io

# Add parent directory to path to import the module
sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

# Import functions from the script to test
from inspect_parquet_data import inspect_parquet, main

@pytest.fixture
def mock_s3fs():
    """Create a mock s3fs filesystem."""
    mock_fs = MagicMock()
    mock_fs.glob.return_value = ['s3://convictionai-data/conviction-ai/clean/train_dataset/file.parquet']
    return mock_fs

@pytest.fixture
def sample_dataframe():
    """Create a sample dataframe for testing."""
    data = {
        'timestamp': pd.date_range(start='2023-01-01', periods=3),
        'symbol': ['AAPL', 'MSFT', 'GOOG'],
        'open': [150.0, 250.0, 2000.0],
        'high': [155.0, 255.0, 2050.0],
        'low': [145.0, 245.0, 1950.0],
        'close': [152.0, 252.0, 2020.0],
        'volume': [10000, 5000, 2000]
    }
    return pd.DataFrame(data)

def test_inspect_parquet(mock_s3fs, sample_dataframe):
    """Test the inspect_parquet function."""
    s3_uri = 's3://convictionai-data/conviction-ai/clean/train_dataset/'
    sample_size = 3
    
    with patch('s3fs.S3FileSystem', return_value=mock_s3fs):
        with patch('pandas.read_parquet', return_value=sample_dataframe):
            with patch('builtins.print') as mock_print:
                # Call the function
                inspect_parquet(s3_uri, sample_size)
                
                # Verify print was called with expected information
                assert mock_print.call_count > 5  # Several print statements should be called
                
                # Check that glob was called with the right path
                mock_s3fs.glob.assert_called_once_with(f"{s3_uri.rstrip('/')}/**/*.parquet", detail=False)
                
                # Verify read_parquet was called with the correct arguments
                pd.read_parquet.assert_called_once_with(
                    's3://convictionai-data/conviction-ai/clean/train_dataset/file.parquet', 
                    filesystem=mock_s3fs
                )

def test_main():
    """Test the main function."""
    test_args = ['inspect_parquet_data.py', '--s3-uri', 's3://test-bucket/path/', '--sample-size', '3']
    
    with patch('sys.argv', test_args):
        with patch('inspect_parquet_data.inspect_parquet') as mock_inspect:
            # Call the function
            main()
            
            # Verify inspect_parquet was called with the correct arguments
            mock_inspect.assert_called_once_with('s3://test-bucket/path/', 3)

def test_no_parquet_files():
    """Test behavior when no parquet files are found."""
    s3_uri = 's3://empty-bucket/'
    mock_fs = MagicMock()
    mock_fs.glob.return_value = []
    
    with patch('s3fs.S3FileSystem', return_value=mock_fs):
        with patch('builtins.print') as mock_print:
            with pytest.raises(SystemExit) as e:
                inspect_parquet(s3_uri, 5)
            
            assert e.value.code == 1
            mock_print.assert_called_with("❌ No parquet files found under s3://empty-bucket/", file=sys.stderr)
