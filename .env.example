# API keys
NEWS_API_KEY=your_news_api_key_here
FRED_API_KEY=your_fred_api_key_here

# Polygon credentials
POLYGON_API_KEY=your_polygon_api_key_here
POLYGON_SECRET_KEY=your_polygon_secret_key_here
POLYGON_S3_ENDPOINT=https://files.polygon.io
POLYGON_S3_BUCKET=flatfiles

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
ASSISTANT_ID=your_assistant_id_here

# AWS / S3 / EC2 (use IAM roles when possible)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name

# Telegram alerts
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Example export commands:
# export TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"
# export TELEGRAM_CHAT_ID="-1001234567890"

# Usage examples for sending Telegram alerts:
# python -c "from src.telegram_alerts import send_message; send_message('TRAINING SUCCESS','Model training completed successfully')"
# python -c "from src.telegram_alerts import send_message; send_message('DRIFT DETECTED','Data drift found in features')"