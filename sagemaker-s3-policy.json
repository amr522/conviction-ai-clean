{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3BucketListAndLocation",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::convictionai-data",
        "arn:aws:s3:::sagemaker-us-east-1-773934887314"
      ]
    },
    {
      "Sid": "AllowS3ObjectOps",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::convictionai-data/*",
        "arn:aws:s3:::sagemaker-us-east-1-773934887314/*"
      ]
    },
    {
      "Sid": "AllowSpecificStackingData",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::convictionai-data/conviction-ai/stacking-data/stacking-data.csv"
      ]
    },
    {
      "Sid": "AllowECRPull",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability"
      ],
      "Resource": "*"
    }
  ]
}